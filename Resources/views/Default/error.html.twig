{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="breadcrumb-item"><a href="{{ path('pumukitnewadmin_mms_shortener', {'id': multimediaObject.id}) }}">{{ multimediaObject.title }}</a></li>
            <li class="breadcrumb-item active">{% trans %}Cut multimedia object{% endtrans %}</li>
        </ul>
    </h3>

    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <span>{% trans %}This video cannot be cut{% endtrans %}: {{ msg|trans }}</span>
        <a class="btn btn-sm btn-secondary ms-auto" href="{{ path('pumukitnewadmin_mms_shortener', {'id': multimediaObject.id}) }}">{% trans %}Go back{% endtrans %}</a>
    </div>
{% endblock %}
